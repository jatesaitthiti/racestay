{
  "_comment": "RaceStay event-discovery sources. Used by Claude (manual research) and any future fetcher script. Checked 2026-10-22.",
  "rules": {
    "takeFromDiscovery": "ONLY the event name (+ the listing URL as a pointer). Never copy descriptions, images or other details.",
    "researchYourself": "date, start/finish point + coordinates, distances, start times, province — from official sources (role=verify, organizer site/page).",
    "writeOwnBlurbs": "blurbTh / blurbEn are always written by us.",
    "skipVirtual": "Skip virtual runs (no physical start). Keywords: virtual, เวอร์ชวล, เสมือน, วิ่งที่ไหนก็ได้, VR, online run.",
    "provenance": "Every event in events.json gets source + checkedOn; owner reviews before publishing.",
    "politeFetching": "Respect robots.txt, max ~1 request / 3 s per host, cache pages, identify the user agent. Do NOT call private/undocumented APIs (e.g. api.race.thai.run/graphql)."
  },
  "fetchModes": {
    "html": "Event names are in the server-rendered HTML — fetch with a plain HTTP request.",
    "browser": "Page is a JavaScript app (SPA) — render in a browser to read the visible list.",
    "manual": "Bot-protected or no stable list — open by hand in a browser."
  },
